# Étape 1 : builder l'application Angular
FROM node:20 AS build

# Définir le répertoire de travail
WORKDIR /app

# Copier package.json et package-lock.json
COPY package*.json ./

# Installer les dépendances
RUN npm install

# Copier le reste du code
COPY . .

# Construire l'application pour la production
RUN npm run build --prod

# Étape 2 : serveur Nginx pour servir les fichiers
FROM nginx:alpine

# Copier les fichiers build depuis l'étape précédente
COPY --from=build /app/dist/nom-de-ton-app /usr/share/nginx/html

# Copier un fichier de configuration Nginx si nécessaire
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Exposer le port
EXPOSE 80

# Démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]